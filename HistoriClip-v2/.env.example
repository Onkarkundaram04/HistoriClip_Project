# ═══════════════════════════════════════════════════════════════
# HistoriClip - Example Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Single .env for the entire project.
# Copy this file, rename it to .env, and fill in your actual keys.
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL!
# ═══════════════════════════════════════════════════════════════

# ─── API Keys ─────────────────────────────────────────────────

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_API_KEY_HERE
MAPILLARY_CLIENT_TOKEN=YOUR_MAPILLARY_CLIENT_TOKEN_HERE

# ─── Database (MySQL) ─────────────────────────────────────────

DB_HOST=localhost
DB_PORT=3306
DB_NAME=historiclip
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# ─── Backend (Node.js :5000) ──────────────────────────────────

NODE_ENV=development
PORT=5000
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRY=7d
AI_SERVICE_SECRET=historiclip_ai_service_secret_key_2026_dev
PYTHON_AI_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:80,http://localhost:5000,http://localhost:5500,http://localhost:8000

# ─── AI Service (Python Flask :5001) ──────────────────────────

FLASK_PORT=5001
FLASK_DEBUG=false
GEMINI_MODEL=gemini-2.5-flash-lite
CORS_ORIGINS=http://localhost:5000,http://localhost:80,http://localhost:8000

# ─── Optional Overrides ──────────────────────────────────────
# Uncomment to override defaults from config.py

# VISUAL_STEPS=8
# VISUAL_GUIDANCE=0.0
# TTS_VOICE=en-GB-RyanNeural
# VIDEO_CODEC=auto
